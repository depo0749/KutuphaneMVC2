@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Erişim Reddedildi</h4>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
                    <h3 class="mt-3">Bu sayfaya erişim yetkiniz bulunmamaktadır.</h3>
                    <p class="text-muted">Lütfen yöneticinizle iletişime geçin veya farklı bir hesap ile giriş yapın.</p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="bi bi-house me-2"></i>Ana Sayfa
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-secondary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 
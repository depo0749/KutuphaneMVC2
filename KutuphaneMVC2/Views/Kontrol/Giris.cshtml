@{
    ViewData["Title"] = "Giris";
    Layout = "_Layout"; 
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4>Giriş Yap</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Giris" method="post">
                        <div class="form-group mb-3">
                            <label for="kullaniciAdi">Kullanıcı Adı</label>
                            <input type="text" class="form-control" id="kullaniciAdi" name="kullaniciAdi" required />
                        </div>
                        <div class="form-group mb-3">
                            <label for="sifre">Şifre</label>
                            <input type="password" class="form-control" id="sifre" name="sifre" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                        @if (ViewBag.Hata != null)
                        {
                            <div class="alert alert-danger mt-3">@ViewBag.Hata</div>
                        }
                    </form>
                </div>
                <div class="card-footer text-center">
                    <a href="/Kontrol/Kayit">Hesabınız yok mu? Kayıt Olun</a>
                </div>
            </div>
        </div>
    </div>
</div>
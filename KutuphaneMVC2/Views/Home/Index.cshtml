@{
    ViewData["Title"] = "Ana Sayfa";
}
@model KutuphaneContext;
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12 text-center mb-5">
            <h1 class="display-4">Kütüphane Yönetim Sistemine Hoş Geldiniz</h1>
            <p class="lead">Kitapları yönetin, ödünç işlemlerini takip edin ve kullanıcıları yönetin.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-book display-1 text-primary mb-3"></i>
                    <h3 class="card-title">Kitap Yönetimi</h3>
                    <p class="card-text">Kütüphanedeki kitapları görüntüleyin, ekleyin ve düzenleyin.</p>
                    <a asp-controller="Kitap" asp-action="Index" class="btn btn-primary">Kitaplara Git</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people display-1 text-success mb-3"></i>
                    <h3 class="card-title">Kullanıcı Yönetimi</h3>
                    <p class="card-text">Kullanıcıları görüntüleyin, ekleyin ve düzenleyin.</p>
                    <a asp-controller="Kullanici" asp-action="Index" class="btn btn-success">Kullanıcılara Git</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-journal-text display-1 text-info mb-3"></i>
                    <h3 class="card-title">Ödünç İşlemleri</h3>
                    <p class="card-text">Kitap ödünç alma ve iade işlemlerini yönetin.</p>
                    <a asp-controller="Odunc" asp-action="Index" class="btn btn-info">Ödünç İşlemlerine Git</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Hızlı İstatistikler</h4>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h5>Toplam Kitap</h5>
                            <p class="display-4">2</p>
                        </div>
                        <div class="col-md-4">
                            <h5>Toplam Kullanıcı</h5>
                            <p class="display-4">1</p>
                        </div>
                        <div class="col-md-4">
                            <h5>Aktif Ödünçler</h5>
                            <p class="display-4">0</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
